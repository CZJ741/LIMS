<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:flowable="http://flowable.org/bpmn"
             targetNamespace="http://lims.com/processes"
             id="Definitions_ContractAudit">

    <process id="contract-audit" name="阶段一：合同登记与审核流程" isExecutable="true">
        <!-- 启动事件 -->
        <startEvent id="startEvent" name="发起合同登记" />

        <!-- 阶段一：财务审核任务 -->
        <userTask id="task_finance_audit" name="财务审核"
                  flowable:candidateGroups="FINANCE_SPECIALIST"
                  flowable:category="CONTRACT">
            <documentation>财务人员审查合同条款、收费金额与付款方式</documentation>
        </userTask>

        <!-- 审核结果排他网关 -->
        <exclusiveGateway id="gateway_audit" name="审核结果决策" />

        <!-- 驳回修改任务 -->
        <userTask id="task_sales_modify" name="市场员修改合同"
                  flowable:candidateGroups="SALES_REP"
                  flowable:category="CONTRACT">
            <documentation>被财务驳回后市场员修正合同信息并重新提报</documentation>
        </userTask>

        <!-- 流程归档服务任务 (可选或直接结束) -->
        <endEvent id="endEvent_approved" name="合同审核通过结束" />
        <endEvent id="endEvent_cancelled" name="合同作废终止" />

        <!-- 连线定义 -->
        <sequenceFlow id="flow_start_to_audit" sourceRef="startEvent" targetRef="task_finance_audit" />

        <sequenceFlow id="flow_audit_to_gateway" sourceRef="task_finance_audit" targetRef="gateway_audit" />

        <!-- 网关分支：审核通过 -->
        <sequenceFlow id="flow_gateway_pass" name="审核通过" sourceRef="gateway_audit" targetRef="endEvent_approved">
            <conditionExpression xsi:type="tFormalExpression"><![CDATA[${auditPass == true}]]></conditionExpression>
        </sequenceFlow>

        <!-- 网关分支：驳回市场员修改 -->
        <sequenceFlow id="flow_gateway_reject" name="审核驳回" sourceRef="gateway_audit" targetRef="task_sales_modify">
            <conditionExpression xsi:type="tFormalExpression"><![CDATA[${auditPass == false}]]></conditionExpression>
        </sequenceFlow>

        <!-- 市场员重新提交审核 -->
        <sequenceFlow id="flow_resubmit" name="重新提交" sourceRef="task_sales_modify" targetRef="task_finance_audit" />

    </process>
</definitions>
