<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:flowable="http://flowable.org/bpmn"
             targetNamespace="http://lims.com/processes"
             id="Definitions_DetectionProcess">

    <process id="detection-process" name="阶段四：检测分析流程" isExecutable="true">
        <startEvent id="startEvent_detection" name="样品送达检测室" />

        <!-- 1. 实验室样品接收与入库 -->
        <userTask id="task_sample_receive" name="样品接收与登记"
                  flowable:candidateGroups="SAMPLE_ADMIN,LAB_DIRECTOR"
                  flowable:category="DETECTION">
            <documentation>样品管理员确认样品外观、温控条件并完成扫码接收</documentation>
        </userTask>

        <!-- 2. 任务分发 -->
        <userTask id="task_assign_detection" name="检测任务认领与分发"
                  flowable:candidateGroups="LAB_DIRECTOR"
                  flowable:category="DETECTION">
            <documentation>实验室主任根据分析项目指派分析员或由分析员认领</documentation>
        </userTask>

        <!-- 3. 分析员实验检测与录入 -->
        <userTask id="task_do_testing" name="实验前处理与数据测定"
                  flowable:candidateGroups="ANALYST"
                  flowable:category="DETECTION">
            <documentation>分析员开展样品前处理、上机测定、仪器数据接入与质控样录入</documentation>
        </userTask>

        <!-- 4. 实验数据复审 -->
        <userTask id="task_data_recheck" name="实验原始数据复审"
                  flowable:candidateGroups="DATA_REVIEWER"
                  flowable:category="DETECTION">
            <documentation>复审人核对空白试验、平行样相对偏差及质控回收率</documentation>
        </userTask>

        <!-- 复审结果网关 -->
        <exclusiveGateway id="gateway_recheck" name="复审决策网关" />

        <!-- 驳回重测任务 -->
        <userTask id="task_retesting" name="重新前处理检测"
                  flowable:candidateGroups="ANALYST"
                  flowable:category="DETECTION">
            <documentation>质控不合格或数据异常，重新提取样品再次试验测定</documentation>
        </userTask>

        <endEvent id="endEvent_detection_finish" name="检测完成数据归档" />

        <!-- 连线定义 -->
        <sequenceFlow id="flow_d1" sourceRef="startEvent_detection" targetRef="task_sample_receive" />
        <sequenceFlow id="flow_d2" sourceRef="task_sample_receive" targetRef="task_assign_detection" />
        <sequenceFlow id="flow_d3" sourceRef="task_assign_detection" targetRef="task_do_testing" />
        <sequenceFlow id="flow_d4" sourceRef="task_do_testing" targetRef="task_data_recheck" />
        <sequenceFlow id="flow_d5" sourceRef="task_data_recheck" targetRef="gateway_recheck" />

        <!-- 复审通过 -->
        <sequenceFlow id="flow_d_pass" name="复审合格" sourceRef="gateway_recheck" targetRef="endEvent_detection_finish">
            <conditionExpression xsi:type="tFormalExpression"><![CDATA[${recheckPass == true}]]></conditionExpression>
        </sequenceFlow>

        <!-- 复审驳回 -->
        <sequenceFlow id="flow_d_reject" name="质控不合格驳回" sourceRef="gateway_recheck" targetRef="task_retesting">
            <conditionExpression xsi:type="tFormalExpression"><![CDATA[${recheckPass == false}]]></conditionExpression>
        </sequenceFlow>

        <!-- 重新检测后送复审 -->
        <sequenceFlow id="flow_d_resubmit" name="重新送审" sourceRef="task_retesting" targetRef="task_data_recheck" />
    </process>
</definitions>
