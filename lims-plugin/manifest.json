{
  "manifest_version": 3,
  "name": "LIMS 报告协同与数据采集助手",
  "version": "1.0.0",
  "description": "LIMS 实验室管理系统专用 Chrome 扩展，支持工作站图谱拦截、本地仪器直连与 Native Messaging 打印辅助",
  "permissions": [
    "nativeMessaging",
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost:8080/*",
    "http://127.0.0.1:8080/*",
    "http://localhost:5173/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://localhost:5173/*", "http://localhost:8080/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "LIMS 协同助手"
  }
}
